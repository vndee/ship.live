#!/bin/bash
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# Treat the entire SSH command as data, never as a shell command or word list.
if [ "$#" -ne 0 ] || [[ ! ${SSH_ORIGINAL_COMMAND-} =~ ^ghcr\.io/vndee/ship\.live@sha256:[0-9a-f]{64}$ ]]; then
  printf '%s\n' 'Invalid deployment reference.' >&2
  exit 1
fi
exec sudo -n -- /usr/local/sbin/ship-live-deploy "$SSH_ORIGINAL_COMMAND"
