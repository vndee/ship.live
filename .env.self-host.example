# Public DNS name pointing to this machine. Do not include https:// or a path.
APP_DOMAIN=ship.example.com

# Use URL-safe values. Generate the password with: openssl rand -hex 32
POSTGRES_USER=ship_live
POSTGRES_PASSWORD=replace_with_a_random_hex_value
POSTGRES_DB=ship_live

# Supabase Auth configuration. Set URL and key together. Use a publishable/anon
# key, never service_role. Leave both blank to boot in local preview mode first.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_GOOGLE_ENABLED=true
SUPABASE_GITHUB_ENABLED=true

# GitHub App configuration. Set every value together. Keep the PEM on one quoted
# line with \n escapes, for example "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----".
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Exactly 32 random bytes encoded as 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
