# Required: shared PostgreSQL database. These credentials match compose.yaml and
# are for local development only. Use separate credentials and TLS in production.
DATABASE_URL=postgres://ship_live:ship_live@127.0.0.1:54329/ship_live

# Optional: default organization suggested in the connection dialog.
GITHUB_ORG=your-organization
PORT=3001

# Optional, server-only. Increases public API rate limits for GITHUB_ORG.
# This endpoint still contains public activity only.
GITHUB_TOKEN=

# Configure both to receive live/private activity from an organization webhook.
GITHUB_WEBHOOK_SECRET=
DASHBOARD_ACCESS_KEY=

# Optional: dedicated test PostgreSQL admin connection with CREATE DATABASE rights.
# Integration tests create and drop uniquely named databases, never this database.
# TEST_DATABASE_URL=postgres://ship_live:ship_live@127.0.0.1:54329/postgres
