# Required PostgreSQL database. These credentials match compose.yaml and are
# for local development only. Use your provider's credentials/TLS in production.
DATABASE_URL=postgres://ship_live:ship_live@127.0.0.1:54329/ship_live
PORT=3001

# Exact browser origin. Use the public HTTPS origin in production; do not add a
# path. Keep the browser URL consistent with this value during development.
APP_URL=http://127.0.0.1:5173

# Trusted reverse-proxy hops for per-client request limits. Keep 0 for direct
# access; change only after verifying the fixed proxy path and header handling.
TRUST_PROXY_HOPS=0

# Supabase Auth: configure Google and GitHub OAuth providers in its Dashboard.
# Provider client secrets belong there, not here. Use the publishable key;
# SUPABASE_ANON_KEY is accepted for older projects. Never use a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_GOOGLE_ENABLED=true
SUPABASE_GITHUB_ENABLED=true

# Optional GitHub App integration. Configure ALL fields together, or leave ALL
# blank for personal notes and demo only. This App is separate from the OAuth
# App used by Supabase's GitHub sign-in provider. See docs/configuration.md.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Exactly 32 random bytes encoded as 64 hexadecimal characters. Encrypts GitHub
# App user/refresh tokens on the server. Keep the same key across replicas.
# Preserve the key securely during upgrades and database restores.
TOKEN_ENCRYPTION_KEY=

# Dedicated test PostgreSQL admin connection with CREATE DATABASE rights.
# Tests create/drop uniquely named databases, never this administration DB.
# TEST_DATABASE_URL=postgres://ship_live:ship_live@127.0.0.1:54329/postgres
