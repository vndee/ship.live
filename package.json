{
  "name": "ship.live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private ship journals and live GitHub activity for individual builders and teams.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vndee/ship.live.git"
  },
  "homepage": "https://github.com/vndee/ship.live#readme",
  "bugs": {
    "url": "https://github.com/vndee/ship.live/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && NODE_ENV=production vite build",
    "start": "tsx server/production.ts",
    "db:migrate": "tsx server/migrate.ts",
    "db:import-json": "tsx server/import-json.ts",
    "test": "node --import tsx --test src/lib/*.test.ts server/*.test.ts",
    "test:db": "node --import tsx server/test-database.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src server shared docs .github *.json *.ts *.md *.yaml index.html",
    "format:check": "prettier --check src server shared docs .github *.json *.ts *.md *.yaml index.html"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "ipaddr.js": "1.9.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
