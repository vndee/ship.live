{
  "name": "ship.live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A live GitHub activity wall that celebrates engineering teams.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vndee/ship.live.git"
  },
  "homepage": "https://github.com/vndee/ship.live#readme",
  "bugs": {
    "url": "https://github.com/vndee/ship.live/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/production.ts",
    "test": "node --import tsx --test src/lib/*.test.ts server/*.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src server shared docs .github *.json *.ts *.md index.html",
    "format:check": "prettier --check src server shared docs .github *.json *.ts *.md index.html"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
